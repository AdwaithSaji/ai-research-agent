# Copy to backend/.env and fill in as needed. All values below are optional —
# the system runs fully offline in mock mode with zero configuration.

# --- LLM provider (OpenAI-compatible). Leave blank to run in offline mock mode. ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Search provider ---
# auto: use Tavily if TAVILY_API_KEY is set, else free DuckDuckGo scraping.
SEARCH_PROVIDER=auto
TAVILY_API_KEY=

# --- Research bounds (cost / latency control) ---
MAX_SUBQUESTIONS=4
MAX_RESULTS_PER_QUERY=5
MAX_SOURCES_TOTAL=12
MAX_SOURCES_FOR_EVIDENCE=8
MAX_SOURCES_PER_DOMAIN=3
MAX_FETCH_CHARS=6000
MAX_EVIDENCE_CHARS_PER_SOURCE=1200
FETCH_TIMEOUT_SECONDS=10
FETCH_MAX_RETRIES=2
REQUEST_CONCURRENCY=5

# --- Storage ---
DATABASE_PATH=research_agent.db
CACHE_TTL_SECONDS=3600

# --- Server ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development
